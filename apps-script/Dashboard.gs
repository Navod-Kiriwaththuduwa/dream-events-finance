function dashboard_(user){ const events=getRows_('03_EVENTS');const expenses=getRows_('17_EXPENSES').filter(x=>x.Approval_Status==='APPROVED');const income=getRows_('16_INCOME').filter(x=>x.Approval_Status==='APPROVED');const payables=getRows_('20_PAYABLES').filter(x=>x.Status!=='PAID'&&x.Status!=='CANCELLED');const revenue=income.reduce((a,b)=>a+Number(b.Amount||0),0);const costs=expenses.reduce((a,b)=>a+Number(b.Amount||0),0);const confirmed=events.filter(x=>!['CANCELLED','ARCHIVED'].includes(x.Status)).reduce((a,b)=>a+Number(b.Confirmed_Value||0),0);const upcoming=listEvents_(user).filter(e=>e.date&&e.date>=Utilities.formatDate(new Date(),'Asia/Colombo','yyyy-MM-dd')).sort((a,b)=>a.date.localeCompare(b.date)).slice(0,5);return {activeEvents:events.filter(x=>!['COMPLETED','FINANCIALLY_CLOSED','CANCELLED','ARCHIVED'].includes(x.Status)).length,revenue:revenue,expenses:costs,eventProfit:user.Role==='FINANCE_HEAD'?revenue-costs:null,receivables:user.Role==='FINANCE_HEAD'?Math.max(0,confirmed-revenue):null,supplierPayables:user.Role==='FINANCE_HEAD'?sumPayable_(payables,'SUPPLIER'):null,ownerPayable:user.Role==='FINANCE_HEAD'?sumPayable_(payables,'OWNER'):null,teamPayable:user.Role==='FINANCE_HEAD'?sumPayable_(payables,'TEAM_MEMBER'):null,pendingApprovals:expensesPending_()+incomePending_(),upcomingEvents:upcoming}; }
function sumPayable_(rows,type){return rows.filter(x=>x.Payable_Type===type).reduce((a,b)=>a+Number(b.Outstanding||0),0)}
function expensesPending_(){return getRows_('17_EXPENSES').filter(x=>x.Approval_Status==='PENDING').length}
function incomePending_(){return getRows_('16_INCOME').filter(x=>x.Approval_Status==='PENDING').length}
