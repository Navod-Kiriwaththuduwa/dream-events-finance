function login_(data){ requireFields_(data,['username','password']); const username=normalizeUsername_(data.username); const user=getRows_('01_USERS').find(u=>normalizeUsername_(u.Username)===username); if(!user||user.Status!=='ACTIVE')throw new Error('Invalid username or password.'); const lockUntil=user.Locked_Until?new Date(user.Locked_Until):null; if(lockUntil&&lockUntil>new Date())throw new Error('Account temporarily locked. Try again later.'); const ok=hashPassword_(data.password,user.Password_Salt)===String(user.Password_Hash); if(!ok){const fail=Number(user.Failed_Login_Count||0)+1;const patch={Failed_Login_Count:fail,Updated_At:nowIso_()};if(fail>=5)patch.Locked_Until=new Date(Date.now()+15*60*1000).toISOString();updateObjectRow_('01_USERS',user._row,patch);throw new Error('Invalid username or password.');} updateObjectRow_('01_USERS',user._row,{Failed_Login_Count:0,Locked_Until:'',Last_Login:nowIso_(),Updated_At:nowIso_()}); const raw=randomToken_(32), sessionId='SES-'+Utilities.getUuid(), expires=new Date(Date.now()+DE.SESSION_HOURS*3600000).toISOString(); appendObject_('30_SESSIONS',{Session_ID:sessionId,Token_Hash:sha256_(raw),User_ID:user.User_ID,Created_At:nowIso_(),Expires_At:expires,Active:true,Last_Seen:nowIso_(),User_Agent:''}); audit_(user,'LOGIN','AUTH',user.User_ID,null,null,'',{}); return {token:raw,user:publicUser_(user),expiresAt:expires}; }
function requireSession_(raw){ if(!raw)throw new Error('Please sign in.'); const hash=sha256_(raw); const ses=getRows_('30_SESSIONS').find(s=>String(s.Token_Hash)===hash && String(s.Active).toLowerCase()!=='false'); if(!ses||new Date(ses.Expires_At)<=new Date())throw new Error('Session expired. Please sign in again.'); const user=findOne_('01_USERS','User_ID',ses.User_ID); if(!user||user.Status!=='ACTIVE')throw new Error('User access is disabled.'); updateObjectRow_('30_SESSIONS',ses._row,{Last_Seen:nowIso_()}); return user; }
function logout_(raw,user){ const hash=sha256_(raw); const ses=getRows_('30_SESSIONS').find(s=>String(s.Token_Hash)===hash); if(ses)updateObjectRow_('30_SESSIONS',ses._row,{Active:false,Last_Seen:nowIso_()}); audit_(user,'LOGOUT','AUTH',user.User_ID,null,null,'',{}); return true; }
function changePassword(username,currentPassword,newPassword){ const user=getRows_('01_USERS').find(u=>normalizeUsername_(u.Username)===normalizeUsername_(username)); if(!user||hashPassword_(currentPassword,user.Password_Salt)!==String(user.Password_Hash))throw new Error('Current credentials are invalid.'); if(String(newPassword).length<10)throw new Error('New password must be at least 10 characters.'); const salt=randomToken_(16);updateObjectRow_('01_USERS',user._row,{Password_Salt:salt,Password_Hash:hashPassword_(newPassword,salt),Updated_At:nowIso_()});return true; }
