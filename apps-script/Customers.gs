function listCustomers_(user){ return getRows_('02_CUSTOMERS').filter(r=>r.Status!=='ARCHIVED').map(r=>({customerId:r.Customer_ID,name:r.Customer_Name,mobile:r.Mobile,whatsapp:r.WhatsApp,email:r.Email,address:r.Address,source:r.Source,notes:r.Notes,status:r.Status,createdAt:r.Created_At})); }
function createCustomer_(user,data){ requireFinance_(user);requireFields_(data,['name','mobile']);const id=nextNumber_('CUSTOMER','DE-CUS-',4).replace(String(new Date().getFullYear())+'-','');const rec={Customer_ID:id,Customer_Name:String(data.name).trim(),Mobile:String(data.mobile||'').trim(),WhatsApp:String(data.whatsapp||'').trim(),Email:String(data.email||'').trim(),Address:String(data.address||'').trim(),Source:String(data.source||'').trim(),Notes:String(data.notes||'').trim(),Status:'ACTIVE',Created_At:nowIso_(),Created_By:user.User_ID,Updated_At:nowIso_(),Updated_By:user.User_ID};appendObject_('02_CUSTOMERS',rec);audit_(user,'CREATE_CUSTOMER','CUSTOMERS',id,null,rec,'',{});return {customerId:id,name:rec.Customer_Name,mobile:rec.Mobile,whatsapp:rec.WhatsApp,email:rec.Email,source:rec.Source,status:rec.Status}; }
